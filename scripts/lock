#!/usr/bin/python3
"""Regenerate requirements/*.txt: every pin with every file hash PyPI has for it.

Maintainer tool, not run on install. scripts/setup installs with
--require-hashes, so each line lists the sha256 of every wheel and sdist of
that version: pip may pick a different wheel on another Python or CPU, and
any of them is acceptable as long as it is one PyPI published.

    scripts/lock        # after changing the pins below
"""
import json
import sys
import urllib.request
from pathlib import Path

BUILD = {  # what python-kasa's sdist needs to build (its pyproject: hatchling)
    "hatchling": "1.32.4", "packaging": "26.3", "pathspec": "1.1.1",
    "pluggy": "1.6.0", "tomlkit": "0.15.1", "trove-classifiers": "2026.9.21.13",
}
RUNTIME = {
    "aiohappyeyeballs": "2.7.1", "aiohttp": "3.14.3", "aiosignal": "1.4.0",
    "asyncclick": "8.4.2.1", "attrs": "26.1.0", "cffi": "2.1.1", "cryptography": "50.0.1",
    "ecdsa": "0.19.2", "frozenlist": "1.8.0", "idna": "3.20", "mashumaro": "3.22",
    "multidict": "6.9.1", "passlib": "1.7.4", "propcache": "0.5.4", "pycparser": "3.0",
    "six": "1.17.0", "typing_extensions": "4.16.0", "yarl": "1.25.1",
}
# python-kasa PR #1592 (TPAP), as GitHub's archive of one commit. Checked by
# downloading it twice and comparing; replace with a PyPI pin once released.
KASA = ("python-kasa @ https://github.com/ZeliardM/python-kasa/archive/"
        "e7084472972f08f2e2235b342f3964aedbfaeb3b.tar.gz"
        " --hash=sha256:08209531e261a68d5ac4debcd33dd98c15143cd24752cb0ba6aa61faa0ef6cbd")


def hashes(name: str, version: str) -> list[str]:
    url = f"https://pypi.org/pypi/{name}/{version}/json"
    with urllib.request.urlopen(url, timeout=30) as r:
        data = json.load(r)
    out = sorted({f["digests"]["sha256"] for f in data["urls"]})
    if not out:
        sys.exit(f"lock: {name}=={version} has no files on PyPI")
    return out


def write(path: Path, pins: dict, extra: list[str] = ()) -> None:
    lines = [f"# Generated by scripts/lock. Do not edit by hand.", ""]
    for name, version in sorted(pins.items(), key=lambda p: p[0].lower()):
        hs = " \\\n    ".join(f"--hash=sha256:{h}" for h in hashes(name, version))
        lines.append(f"{name}=={version} \\\n    {hs}")
    lines += list(extra)
    path.write_text("\n".join(lines) + "\n")
    print(f"wrote {path}")


here = Path(__file__).resolve().parent.parent / "requirements"
here.mkdir(exist_ok=True)
write(here / "build.txt", BUILD)
write(here / "runtime.txt", RUNTIME, [KASA])
